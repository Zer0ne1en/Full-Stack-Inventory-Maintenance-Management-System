# ---------------------------------------------------------------------
# Mainspring — copy to `.env` and adjust.
# `docker compose` reads this file automatically; Spring Boot reads the same
# variable names through its relaxed binding.
# ---------------------------------------------------------------------

# ---- Database -------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmms
DB_USER=cmms
DB_PASSWORD=cmms

# ---- Security -------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-bytes
JWT_EXPIRATION_MINUTES=720

# ---- Frontend / CORS -----------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Alert engine ---------------------------------------------------
ALERT_CRON=0 */15 * * * *
ALERT_OVERDUE_HOURS=72
ALERT_SERVICE_WINDOW_DAYS=14
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_RECIPIENT=ops@yourplant.example
ALERT_EMAIL_FROM=no-reply@yourplant.example

# ---- SMTP (JavaMailSender) -----------------------------------------
# Leave SMTP_HOST empty to disable mail delivery entirely; alerts still appear
# in the in-app feed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Bootstrap ------------------------------------------------------
# true seeds a realistic demo plant the first time the API starts on an empty DB
SEED_DEMO_DATA=true
